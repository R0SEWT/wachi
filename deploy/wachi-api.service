[Unit]
Description=Wachi API
After=network-online.target

[Service]
WorkingDirectory=%h/wachi/api
# --limit-concurrency: más de 16 conexiones a la vez reciben 503 en vez de encolarse sin fin.
ExecStart=%h/.local/bin/uv run uvicorn wachi.api:app --host 127.0.0.1 --port 8000 --limit-concurrency 16
Restart=on-failure
RestartSec=5
Nice=10
# Topes del cgroup (la 4060 delega cpu y memory al usuario). Pico medido: ~1,25 GB al reconstruir la
# caché del grafo y ~0,8 GB sirviendo rutas.
MemoryMax=2G
CPUQuota=200%
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
